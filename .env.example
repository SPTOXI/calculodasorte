# ==============================================================================
# CONFIGURAÇÕES E CHAVES DE API — CALCULADORA DA SORTE
# ==============================================================================
# Cole suas chaves de API abaixo. O arquivo .env já está listado no .gitignore
# e NUNCA será enviado publicamente para o GitHub.
# ==============================================================================

# 1. API DE INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI) - RECOMENDADO E GRATUITO
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. API DE INTELIGÊNCIA ARTIFICIAL (MOONSHOT AI KIMI K3) - MODELO DE ALTA PERFORMANCE
# Obtenha sua chave em: https://platform.moonshot.cn ou https://api.moonshot.ai
MOONSHOT_API_KEY=

# 3. API DE INTELIGÊNCIA ARTIFICIAL (ANTHROPIC CLAUDE) - OPCIONAL / FALLBACK
# Obtenha sua chave em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# 3. IDENTIFICADOR INFINITEPAY (CHECKOUT PIX TAXA ZERO & D+0)
INFINITEPAY_HANDLE=silvio_morais_

# 4. CHAVE DE CRIPTOGRAFIA DE SESSÃO FLASK
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Aviso de prêmio por e-mail (escolha uma opção; sem nenhuma, os avisos ficam desligados)
# Opção 1 - Resend (https://resend.com):
RESEND_API_KEY=
# Opção 2 - SMTP (ex.: Gmail com senha de app: smtp.gmail.com, porta 587):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente e endereço usado nos links dos e-mails
EMAIL_FROM=Cálculo da Sorte <avisos@calculodasorte.com.br>
SITE_URL=https://www.calculodasorte.com.br
# Senha inicial do administrador padrão (só usada se a conta ainda não existir)
ADMIN_INITIAL_PASSWORD=
