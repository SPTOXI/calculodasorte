{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/atualizar",
      "schedule": "59 23 * * *"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  }
}
